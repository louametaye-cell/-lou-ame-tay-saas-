datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Language {
  FR
  WO
  EN
  ES
  IT
}

enum ValueType { 
  BOOLEAN 
  NUMERIC 
  TEXT 
}

enum SubscriptionStatus { 
  TRIAL 
  ACTIVE 
  PAST_DUE 
  CANCELED 
  SUSPENDED 
}

enum MealPeriod {
  ALL_DAY
  LUNCH       // 12h00 - 16h00
  DINNER      // 18h00 - 00h00
  NIGHT_SNACK // 00h00 - 06h00
}

enum PaymentProvider { 
  WAVE 
  ORANGE_MONEY 
  CASH 
  CARD
  MANUAL_AGENCY 
}

enum PaymentMethod { 
  CASH 
  WAVE 
  ORANGE_MONEY 
  CARD 
  CASH_TPE 
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus { 
  PENDING 
  SUCCESS 
  FAILED 
  REFUNDED 
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  price         Decimal        @db.Decimal(10, 2)
  currency      String         @default("FCFA")
  description   String?        @db.Text
  colorTheme    String         @default("#FF6B00") @map("color_theme")
  isRecommended Boolean        @default(false) @map("is_recommended")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  planFeatures  PlanFeature[]
  tenants       Tenant[]
  transactions  PaymentTransaction[]

  @@map("plans")
}

model Feature {
  id          String        @id @default(cuid())
  keyName     String        @unique @map("key_name")
  label       String
  description String?       @db.Text
  category    String        @default("CORE")
  valueType   ValueType     @default(BOOLEAN) @map("value_type")
  createdAt   DateTime      @default(now()) @map("created_at")

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  featureId  String   @map("feature_id")
  isActive   Boolean  @default(true) @map("is_active")
  limitValue Int?     @map("limit_value")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId], name: "uq_plan_feature")
  @@map("plan_features")
}

model Tenant {
  id                    String             @id @default(cuid())
  businessName          String             @map("business_name")
  subdomain             String             @unique
  ownerName             String?            @map("owner_name")
  phone                 String
  address               String?
  city                  String             @default("Dakar")
  logoUrl               String?            @db.Text @map("logo_url")
  bannerUrl             String?            @db.Text @map("banner_url")
  currency              String             @default("FCFA")
  currentPlanId         String             @map("current_plan_id")
  subscriptionStatus    SubscriptionStatus @default(TRIAL) @map("subscription_status")
  trialEndsAt           DateTime?          @map("trial_ends_at")
  subscriptionExpiresAt DateTime?          @map("subscription_expires_at")
  monthlyFee            Decimal            @default(15000) @map("monthly_fee") @db.Decimal(10, 2)
  waveMerchantId        String?            @map("wave_merchant_id")
  omMerchantNumber      String?            @map("om_merchant_number")
  lastSeenAt            DateTime?          @map("last_seen_at")
  qrScansToday          Int                @default(0) @map("qr_scans_today")
  ordersToday           Int                @default(0) @map("orders_today")
  storageUsedMb         Int                @default(0) @map("storage_used_mb")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  plan         Plan                 @relation(fields: [currentPlanId], references: [id])
  transactions PaymentTransaction[]
  categories   Category[]
  tables       Table[]
  orders       Order[]
  combos       ComboDeal[]
  upsellRules  UpsellRule[]
  menuItems    MenuItem[]

  @@map("tenants")
}

model Category {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  name         String
  icon         String?
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([tenantId, displayOrder])
  @@map("categories")
}

model Table {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  tableNumber  Int            @map("table_number")
  label        String?
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     TableSession[]
  orders       Order[]

  @@unique([tenantId, tableNumber], name: "uq_tenant_table")
  @@index([tenantId, isActive])
  @@map("tables")
}

model TableSession {
  id          String      @id @default(cuid())
  tableId     String      @map("table_id")
  isActive    Boolean     @default(true) @map("is_active")
  sharedCart  Json?       @map("shared_cart")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  table       Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("table_sessions")
}

model MenuItem {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  categoryId     String?      @map("category_id")
  name           String
  description    String?      @db.Text
  price          Decimal      @db.Decimal(10, 2)
  period         MealPeriod   @default(ALL_DAY)
  viewsCount     Int          @default(0)   @map("views_count")
  salesCount     Int          @default(0)   @map("sales_count")
  isDailySpecial Boolean      @default(false) @map("is_daily_special")
  imageUrl       String?      @db.Text @map("image_url")
  isAvailable    Boolean      @default(true) @map("is_available")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations   MenuItemTranslation[]
  upsellRules    UpsellRule[]          @relation("SuggestedItems")
  orderItems     OrderItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([period])
  @@index([isDailySpecial])
  @@map("menu_items")
}

model UpsellRule {
  id              String      @id @default(cuid())
  tenantId        String      @map("tenant_id")
  triggerItemId   String?     @map("trigger_item_id")
  suggestedItemId String      @map("suggested_item_id")
  discountPrice   Decimal?    @map("discount_price") @db.Decimal(10, 2)
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suggestedItem   MenuItem    @relation("SuggestedItems", fields: [suggestedItemId], references: [id], onDelete: Cascade)

  @@map("upsell_rules")
}

model ComboDeal {
  id             String      @id @default(cuid())
  tenantId       String      @map("tenant_id")
  name           String      // ex: "Formule Midi Teranga"
  description    String?     @db.Text
  fixedPrice     Decimal     @map("fixed_price") @db.Decimal(10, 2)
  period         MealPeriod  @default(LUNCH)
  availableFrom  String      @default("12:00") @map("available_from")
  availableTo    String      @default("16:00") @map("available_to")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("combo_deals")
}

model MenuItemTranslation {
  id          String   @id @default(cuid())
  menuItemId  String   @map("menu_item_id")
  language    Language
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, language])
  @@map("menu_item_translations")
}

model Order {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  tableId          String?       @map("table_id")
  tableNumber      Int           @map("table_number")
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus    String        @default("UNPAID") @map("payment_status")
  transactionRef   String?       @map("transaction_ref")
  customerName     String?       @map("customer_name")
  customerNote     String?       @db.Text @map("customer_note")
  totalAmount      Decimal       @map("total_amount") @db.Decimal(10, 2)
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table            Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tableNumber])
  @@map("orders")
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String    @map("order_id")
  menuItemId     String?   @map("menu_item_id")
  name           String
  price          Decimal   @db.Decimal(10, 2)
  quantity       Int       @default(1)
  selectedSide   String?   @map("selected_side")
  selectedSpice  String?   @map("selected_spice")
  selectedExtras Json?     @map("selected_extras")
  customNotes    String?   @map("custom_notes")

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model PaymentTransaction {
  id                String          @id @default(cuid())
  tenantId          String          @map("tenant_id")
  planId            String          @map("plan_id")
  amount            Decimal         @db.Decimal(10, 2)
  provider          PaymentProvider
  providerTxId      String?         @map("provider_tx_id")
  status            PaymentStatus   @default(PENDING)
  webhookVerifiedAt DateTime?       @map("webhook_verified_at")
  periodMonths      Int             @default(1) @map("period_months")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("payment_transactions")
}